<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="CombatScreen.uss" />
    <Style src="RunScreen.uss" />
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement class="top-bar">
            <ui:Label text="The Black Keep" class="place" />
            <ui:Label name="depth" class="round" />
            <ui:VisualElement name="party-health" class="party-health" />
            <ui:Label name="deck-count" class="with-icon deck-count"><ui:VisualElement class="ui-icon icon-deck label-icon" picking-mode="Ignore" /></ui:Label>
            <ui:Label name="keepsake-count" class="with-icon deck-count"><ui:VisualElement class="ui-icon icon-keepsake label-icon" picking-mode="Ignore" /></ui:Label>
            <ui:Label name="seed" class="seed" />
            <ui:Button name="journal" text="Journal" class="with-icon journal-button hidden"><ui:VisualElement class="ui-icon icon-journal label-icon" picking-mode="Ignore" /></ui:Button>
        </ui:VisualElement>

        <ui:VisualElement name="party-view" class="view centred">
            <ui:ScrollView class="party-scroll">
                <ui:VisualElement class="party-scroll-content">
                    <ui:Label text="The Black Keep" class="view-title" />
                    <ui:Label text="A plague, a curse, a missing lord. The rumours all lead to the Black Keep, where the siege ended and something else began. Three of you go in." class="view-text" />
                    <ui:Label text="Choose three heroes." class="view-subtext" />
                    <ui:VisualElement name="party-heroes" class="party-heroes" />
                    <ui:VisualElement class="party-detail">
                        <ui:Label name="party-detail-name" class="party-detail-name" />
                        <ui:Label name="party-detail-cards" class="party-detail-cards" />
                    </ui:VisualElement>
                    <ui:Label name="party-hint" class="hint" />
                    <ui:Button name="enter-keep" text="Enter the Keep" class="big-button" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

        <ui:VisualElement name="map-view" class="view map-view">
            <ui:VisualElement name="map" class="map" />
            <ui:VisualElement class="map-side">
                <ui:Label text="Choose a room" class="panel-heading" />
                <ui:Label name="map-hint" class="map-hint" />
                <ui:Label name="map-legend" class="map-legend" />
                <ui:Label name="clue-count" class="clue-count" />
                <ui:Button name="map-style" class="map-style-button" />
                <ui:Button name="whole-plan" class="map-style-button whole-plan-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="reward-view" class="view centred">
            <ui:Label text="Victory" class="view-title" />
            <ui:Label text="Choose a card to add to the deck, or skip." class="view-text" />
            <ui:Label name="reward-clue" class="with-icon found-clue hidden"><ui:VisualElement class="ui-icon icon-clue label-icon" picking-mode="Ignore" /></ui:Label>
            <ui:VisualElement name="reward-cards" class="card-row" />
            <ui:Label name="reward-hint" class="hint" />
            <ui:Button name="skip-reward" text="Skip" class="big-button" />
        </ui:VisualElement>

        <ui:VisualElement name="sanctuary-view" class="view centred">
            <ui:VisualElement class="ui-icon icon-room-sanctuary narrative-emblem" picking-mode="Ignore" />
            <ui:Label text="Sanctuary" class="view-title" />
            <ui:Label name="sanctuary-text" text="A chapel the corruption never reached. Candles still burn. Rest, or reflect and leave something behind." class="view-text" />
            <ui:VisualElement name="sanctuary-choices" class="choice-row">
                <ui:Button name="rest" text="Rest" class="choice-button" />
                <ui:Button name="reflect" text="Reflect: remove a card from the deck" class="choice-button" />
            </ui:VisualElement>
            <ui:VisualElement name="reflect-panel" class="reflect-panel hidden">
                <ui:ScrollView name="reflect-cards" class="deck-grid-scroll">
                    <ui:VisualElement name="reflect-grid" class="deck-grid" />
                </ui:ScrollView>
                <ui:Button name="reflect-back" text="Back" class="big-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="investigation-view" class="view centred">
            <ui:VisualElement class="ui-icon icon-room-investigation narrative-emblem" picking-mode="Ignore" />
            <ui:Label text="Investigation" class="view-title" />
            <ui:Label name="investigation-text" class="view-text" />
            <ui:Label name="search-help" class="view-subtext" />
            <ui:VisualElement name="searchers" class="choice-row" />
            <ui:Label name="investigation-hint" class="hint" />
            <ui:Button name="leave-investigation" text="Leave it and return to the map" class="big-button" />
        </ui:VisualElement>

        <ui:VisualElement name="secret-view" class="view centred">
            <ui:VisualElement class="ui-icon icon-room-secret narrative-emblem" picking-mode="Ignore" />
            <ui:Label name="secret-title" class="view-title" />
            <ui:Label name="secret-text" class="view-text" />
            <ui:VisualElement class="choice-row">
                <ui:Button name="use-secret" class="choice-button" />
                <ui:Button name="leave-secret" text="Leave it and return to the map" class="choice-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="event-view" class="view centred">
            <ui:VisualElement class="ui-icon icon-room-event narrative-emblem" picking-mode="Ignore" />
            <ui:Label name="event-title" class="view-title" />
            <ui:Label name="event-scene" class="view-text" />
            <ui:VisualElement name="event-choices" class="choice-row" />
            <ui:Label name="event-hero-help" class="view-subtext" />
            <ui:VisualElement name="event-heroes" class="choice-row" />
            <ui:Label name="event-hint" class="hint" />
        </ui:VisualElement>

        <ui:VisualElement name="remove-view" class="view centred">
            <ui:VisualElement class="ui-icon icon-remove-card narrative-emblem" picking-mode="Ignore" />
            <ui:Label text="Leave a card behind" class="view-title" />
            <ui:Label name="remove-text" class="view-text" />
            <ui:ScrollView class="deck-grid-scroll">
                <ui:VisualElement name="remove-grid" class="deck-grid" />
            </ui:ScrollView>
            <ui:Label name="remove-hint" class="hint" />
        </ui:VisualElement>

        <ui:VisualElement name="found-view" class="view centred">
            <ui:VisualElement class="ui-icon icon-clue narrative-emblem" picking-mode="Ignore" />
            <ui:Label name="found-title" class="view-title" />
            <ui:Label name="found-text" class="view-text" />
            <ui:Button name="found-continue" text="Return to the map" class="big-button" />
        </ui:VisualElement>

        <ui:VisualElement name="unwritten-view" class="view centred">
            <ui:VisualElement class="ui-icon icon-empty-folio narrative-emblem" picking-mode="Ignore" />
            <ui:Label name="unwritten-title" class="view-title" />
            <ui:Label name="unwritten-text" class="view-text" />
            <ui:Button name="leave-room" text="Return to the map" class="big-button" />
        </ui:VisualElement>

        <ui:VisualElement name="end-view" class="view centred">
            <ui:VisualElement class="ui-icon icon-seal-whole narrative-emblem" picking-mode="Ignore" />
            <ui:Label name="run-end-title" class="view-title" />
            <ui:Label name="run-end-text" class="view-text" />
            <ui:Label name="run-end-summary" class="run-summary" />
            <ui:Button name="new-expedition" text="New expedition" class="big-button" />
        </ui:VisualElement>

        <!-- Opens over the map from the Journal button. -->
        <ui:VisualElement name="journal-panel" class="journal-panel hidden">
            <ui:VisualElement class="journal-page">
                <ui:Label text="Journal" class="view-title" />
                <ui:ScrollView class="journal-scroll">
                    <ui:VisualElement name="journal-entries" />
                </ui:ScrollView>
                <ui:Button name="journal-close" text="Close" class="big-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
