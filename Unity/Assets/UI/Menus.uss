/* The title, pause and settings menus. They draw over the run and combat screens. */

.menus {
    flex-grow: 1;
    color: rgb(222, 214, 200);
    font-size: 16px;
}

.title-view {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(16, 13, 18);
}

.game-title {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(201, 162, 74);
    margin-bottom: 16px;
}

.menu-button {
    margin-top: 12px;
}

.title-note {
    width: 640px;
    height: auto;
    margin-top: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.menu-overlay {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 8, 12, 0.85);
}

.menu-panel {
    width: 420px;
    padding: 28px 36px;
    align-items: center;
    border-width: 2px;
    border-radius: 8px;
    border-color: rgb(120, 100, 70);
    background-color: rgb(30, 25, 30);
}

.menu-heading {
    font-size: 28px;
    margin-bottom: 8px;
}

.menu-toggle {
    width: 260px;
    margin-top: 14px;
    font-size: 18px;
}

.menu-toggle > .unity-label {
    color: rgb(222, 214, 200);
    min-width: 200px;
}

.menu-note {
    margin-top: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: rgb(150, 140, 146);
}

.title-column {
    align-items: center;
}

/* With a backdrop image (GameMenus loads it when the local art is there), the menu moves to the left third
   over a dark fade, so the lair stays visible on the right. Without one, the title looks as it always has. */
.title-view.has-backdrop {
    align-items: flex-start;
    -unity-background-scale-mode: scale-and-crop;
}

.title-view.has-backdrop .title-column {
    width: 760px;
    padding-left: 90px;
    align-items: flex-start;
}

.title-view.has-backdrop .view-text {
    -unity-text-align: middle-left;
    width: 560px;
    white-space: normal;
}

.title-view.has-backdrop .title-note {
    -unity-text-align: middle-left;
    width: 520px;
}

.title-shade {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
}

.title-view.has-backdrop .title-shade {
    display: flex;
}

/* Overlapping bands stand in for a gradient: darkest behind the menu, fading out towards the lair. */
.title-shade-1 { left: 0; width: 34%; background-color: rgba(10, 8, 12, 0.4); }
.title-shade-2 { left: 0; width: 39%; background-color: rgba(10, 8, 12, 0.18); }
.title-shade-3 { left: 0; width: 44%; background-color: rgba(10, 8, 12, 0.14); }
.title-shade-4 { left: 0; width: 49%; background-color: rgba(10, 8, 12, 0.1); }
.title-shade-5 { left: 0; width: 54%; background-color: rgba(10, 8, 12, 0.07); }
.title-shade-6 { left: 0; width: 59%; background-color: rgba(10, 8, 12, 0.05); }
