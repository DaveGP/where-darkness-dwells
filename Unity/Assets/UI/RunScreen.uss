/* The Siege Ledger. Exact slices match SpriteImporter; default Unity font uses approved sizes. */
.view {
    flex-grow: 1;
}

.centred {
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.view-title {
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.view-text {
    width: 760px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.big-button {
    width: 240px;
    height: 48px;
    margin-top: 16px;
}

.party-health {
    flex-direction: row;
    flex-grow: 1;
}

.health-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 18px;
}

.health-chip .swatch {
    flex-grow: 0;
    border-radius: 0;
    margin-right: 6px;
}

.health-chip-text {
    font-size: 14px;
}

.deck-count {
    margin-right: 24px;
    font-size: 14px;
}

.party-heroes {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 1200px;
}

.party-hero {
    width: 172px;
    margin: 5px 7px;
    padding-top: 0;
    border-width: 2px;
}

.party-portrait {
    height: 150px;
    margin: 0 -12px 8px -12px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    background-color: var(--void);
    -unity-background-scale-mode: scale-to-fit;
    border-bottom-width: 1px;
    border-bottom-color: var(--card-rose);
    justify-content: center;
    align-items: center;
}

.party-portrait-initial {
    font-size: 64px;
    -unity-font-style: bold;
}

.party-detail {
    margin-top: 10px;
    border-radius: 0;
}

.party-detail-name {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.party-detail-cards {
    white-space: normal;
}

.map-view {
    flex-direction: row;
}

.map {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 24px 0 24px 20px;
}

.map-lines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.room {
    position: absolute;
    width: 128px;
    height: 56px;
    margin: 0;
    padding: 0;
    border-width: 2px;
    border-radius: 0;
    border-color: var(--card-rose);
    font-size: 16px;
    -unity-font-style: bold;
}

.room-boss {
    width: 150px;
    height: 72px;
    font-size: 20px;
}

.room.is-reachable {
    color: var(--text);
    border-width: 3px;
}

.map-entrance {
    position: absolute;
    width: 104px;
    height: 48px;
    -unity-text-align: middle-center;
    font-size: 15px;
    -unity-font-style: bold;
    border-width: 2px;
    border-radius: 0;
    border-color: var(--edge);
}

.map-entrance.is-start {
    background-color: var(--selected);
    color: var(--text);
}

.room-glow {
    position: absolute;
    border-radius: 0;
    border-color: var(--scrim);
    opacity: 0.45;
    transition-property: opacity, scale;
    transition-duration: 0.8s;
    transition-timing-function: ease-in-out;
}

.is-pulse .room-glow {
    opacity: 1;
    scale: 1.06 1.06;
    border-color: var(--scrim);
}

.map-side {
    width: 340px;
    flex-shrink: 0;
    padding: 40px 24px;
}

.map-hint {
    white-space: normal;
    min-height: 80px;
    font-size: 16px;
}

.map-style-button {
    margin: 24px 0 0 0;
    align-self: flex-start;
    font-size: 14px;
}

.whole-plan-button {
    margin-top: 8px;
}

.map-legend {
    white-space: normal;
}

.plan-board {
    border-radius: 0;
}

.tile {
    border-width: 2px;
    border-color: var(--card-rose);
    justify-content: center;
    align-items: center;
    overflow: hidden;
    transition-property: scale, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.tile.is-new {
    scale: 0.6 0.6;
    opacity: 0;
}

.tile.has-art {
    -unity-background-image-tint-color: var(--hero-smoke);
}

.tile-art {
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--hero-smoke);
}

.tile.has-art.is-current,
.is-current > .tile-art {
    -unity-background-image-tint-color: var(--text);
}

.tile.has-art.is-current {
    border-width: 3px;
}

.has-art .tile-name {
    -unity-text-outline-color: var(--scrim);
}

.tile-passage {
    border-width: 1px;
}

.tile-name {
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin: 0;
}

.tile-stairs {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    -unity-text-align: lower-center;
    margin: 0;
}

.door {
    position: absolute;
    border-radius: 0;
}

.door-tag {
    position: absolute;
    margin: 0;
    padding: 0 4px;
    border-width: 2px;
    border-radius: 0;
    -unity-font-style: bold;
    white-space: normal;
    transition-property: opacity, scale;
    transition-duration: 0.8s;
    transition-timing-function: ease-in-out;
}

.door-tag:hover {
    opacity: 1;
}

.stairs-tag {
    border-color: var(--hero-thorn);
    font-size: 14px;
}

.cellar-title {
    font-size: 14px;
    -unity-font-style: bold;
}

.card-row {
    flex-direction: row;
    justify-content: center;
    height: 240px;
    align-items: flex-end;
}

.card-row .card:hover,
.deck-grid .card:hover {
    translate: 0 -10px;
    border-color: var(--hero-tallow);
}

.choice-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.choice-button.is-selected {
    border-color: var(--brass);
    border-width: 2px;
}

.choice-button {
    width: 360px;
    height: 64px;
    margin: 0 12px;
    font-size: 16px;
    white-space: normal;
}

.reflect-panel {
    align-items: center;
}

.deck-grid-scroll {
    width: 90%;
    height: 560px;
}

.deck-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.deck-grid .card {
    margin: 14px 6px 0 6px;
}

.run-summary {
    font-size: 16px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.view-subtext {
    width: 760px;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 15px;
    margin-bottom: 16px;
}

.found-clue {
    width: 760px;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 17px;
    margin-bottom: 18px;
}

.clue-count {
    margin-top: 24px;
    font-size: 15px;
}

.journal-button {
    height: 30px;
    margin-left: 18px;
    font-size: 14px;
}

.journal-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.journal-page {
    width: 820px;
    max-height: 90%;
    align-items: center;
    border-width: 2px;
    border-radius: 0;
    border-color: var(--health);
}

.journal-scroll {
    width: 100%;
    flex-shrink: 1;
}

.journal-entry {
    margin-bottom: 14px;
    padding: 10px 14px;
    border-left-width: 3px;
}

.journal-entry.is-unknown {
    border-color: var(--card-rose);
}

.journal-entry-name {
    -unity-font-style: bold;
}

.journal-entry-text {
    white-space: normal;
}

.searcher {
    width: 260px;
}

.map-side,
.journal-page,
.party-detail {
    background-image: url("Art/Frames/folio.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 16;
    -unity-slice-top: 16;
    -unity-slice-right: 16;
    -unity-slice-bottom: 16;
    -unity-slice-scale: 1px;
}

.found-clue,
.run-summary {
    background-image: url("Art/Frames/strip.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 4;
    -unity-slice-top: 4;
    -unity-slice-right: 4;
    -unity-slice-bottom: 4;
    -unity-slice-scale: 1px;
}

.tile-name,
.has-art .tile-name,
.tile-stairs {
    background-image: url("Art/Map/name-plate.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 1px;
}

.tile-passage > .room-wall {
    background-image: url("Art/Map/passage.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 4;
    -unity-slice-top: 4;
    -unity-slice-right: 4;
    -unity-slice-bottom: 4;
    -unity-slice-scale: 1px;
}

.door {
    background-image: url("Art/Map/door-shut.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 4;
    -unity-slice-top: 8;
    -unity-slice-right: 4;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}

.door.is-travelled {
    background-image: url("Art/Map/door-travelled.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 4;
    -unity-slice-top: 8;
    -unity-slice-right: 4;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}

.door.is-open {
    background-image: url("Art/Map/door-open.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 4;
    -unity-slice-top: 8;
    -unity-slice-right: 4;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}

.door-tag,
.stairs-tag {
    background-image: url("Art/Map/door-tag.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 8;
    -unity-slice-top: 8;
    -unity-slice-right: 8;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}

.room,
.map-entrance {
    background-image: url("Art/Map/chart-room.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 1px;
}

.room-glow {
    background-image: url("Art/Map/reachable-rim.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 16;
    -unity-slice-top: 16;
    -unity-slice-right: 16;
    -unity-slice-bottom: 16;
    -unity-slice-scale: 1px;
}

.journal-entry {
    background-image: url("Art/Journal/entry.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 12;
    -unity-slice-top: 8;
    -unity-slice-right: 8;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}

#sanctuary-view,
#investigation-view,
#secret-view,
#event-view,
#found-view,
#unwritten-view,
#end-view {
    background-image: url("Art/Frames/narrative.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 24;
    -unity-slice-top: 16;
    -unity-slice-right: 16;
    -unity-slice-bottom: 16;
    -unity-slice-scale: 1px;
}

.view-title {
    font-size: 40px;
}

.view-text {
    font-size: 18px;
}

.big-button {
    font-size: 16px;
}

.health-chip .swatch {
    width: 24px;
    height: 24px;
    background-color: var(--panel);
}

.health-chip .hero-mark {
    width: 20px;
    height: 20px;
}

.party-hero,
.party-hero:hover,
.party-hero.is-chosen {
    opacity: 1;
}

.party-hero {
    border-color: var(--edge-quiet);
    background-color: var(--panel);
}

.party-hero:hover {
    background-color: var(--hover);
    border-color: var(--brass);
}

.party-hero:active {
    background-color: var(--pressed);
}

.party-hero.is-chosen {
    border-color: var(--focus);
}

.party-portrait-initial {
    width: 64px;
    height: 64px;
    color: rgba(0, 0, 0, 0);
}

.party-hero .combatant-name {
    font-size: 15px;
}

.party-hero .combatant-title {
    font-size: 13px;
    color: var(--text-secondary);
}

.party-detail {
    width: 1160px;
    max-width: 95%;
    height: auto;
    min-height: 150px;
    padding: 12px;
    background-color: var(--panel);
}

.party-detail-name {
    font-size: 16px;
    color: var(--brass);
}

.party-detail-cards {
    font-size: 14px;
    color: var(--text);
}

.map-side,
.journal-page {
    background-color: var(--panel);
}

.room,
.room:hover,
.room:active,
.map-entrance {
    background-color: var(--panel);
    color: var(--text);
}

.room.is-reachable {
    background-color: var(--selected);
}

.room.is-reachable:hover {
    background-color: var(--hover);
    scale: 1 1;
}

.room.is-reachable:active {
    background-color: var(--pressed);
}

.room.is-visited {
    background-color: var(--selected);
    color: var(--text);
}

.room.is-closed {
    opacity: 1;
    color: var(--text-muted);
}

.room.is-current,
.map-entrance.is-start {
    border-color: var(--focus);
}

.room-glow,
.is-pulse .room-glow {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.plan-board {
    background-color: var(--void);
}

.tile {
    background-color: var(--panel);
}

.tile.is-current {
    background-color: var(--panel);
    border-color: var(--focus);
}

.tile.is-unexplored {
    opacity: 1;
    background-color: var(--recess);
}

.tile.is-dark {
    background-color: var(--recess);
}

.tile-passage {
    background-color: var(--panel);
}

.tile-name,
.has-art .tile-name,
.tile-stairs {
    background-color: var(--panel);
    color: var(--text);
    padding: 4px 6px;
    -unity-text-outline-width: 0;
}

.door,
.door.is-travelled,
.door.is-open {
    background-color: rgba(0, 0, 0, 0);
}

.door-tag,
.is-pulse .door-tag {
    opacity: 1;
    background-color: var(--selected);
    color: var(--text);
}

.door-tag:hover {
    background-color: var(--hover);
    border-color: var(--focus);
    scale: 1 1;
}

.door-tag:active {
    background-color: var(--pressed);
}

.tile-room-icon {
    position: absolute;
    left: 5px;
    top: 5px;
    width: 16px;
    height: 16px;
    background-color: var(--panel);
}

.chart-room-icon {
    position: absolute;
    left: 5px;
    top: 16px;
}

.room {
    padding-left: 24px;
}

.room:disabled {
    opacity: 1;
    color: var(--text-muted);
}

.journal-panel {
    background-color: var(--scrim);
}

.journal-page {
    padding: 28px 28px 28px 32px;
}

.journal-entry {
    background-color: var(--panel);
    border-color: var(--room-investigation);
    padding-left: 36px;
}

.journal-entry-name {
    font-size: 20px;
    color: var(--brass);
}

.journal-entry-text {
    font-size: 16px;
    color: var(--text);
}

.journal-entry.is-unknown .journal-entry-name {
    color: var(--text-muted);
}

.searcher.is-unavailable {
    opacity: 1;
}

.run-summary {
    color: var(--text-secondary);
}

.found-clue {
    color: var(--text);
    background-color: var(--panel);
    padding: 8px 28px;
}

.narrative-emblem {
    width: 64px;
    height: 64px;
    margin-bottom: 12px;
    -unity-background-image-tint-color: var(--brass);
}

#sanctuary-view,
#investigation-view,
#secret-view,
#event-view,
#found-view,
#unwritten-view,
#end-view {
    background-color: var(--panel);
    margin: 24px;
}

.hidden {
    display: none;
}

.tile-entrance,
.room-entrance {
    border-color: var(--room-entrance);
}

.tile-entrance .tile-room-icon,
.room-entrance .chart-room-icon {
    -unity-background-image-tint-color: var(--room-entrance);
}

.tile-entrance > .room-wall {
    -unity-background-image-tint-color: var(--room-entrance);
}

.tile-combat,
.room-combat {
    border-color: var(--room-combat);
}

.tile-combat .tile-room-icon,
.room-combat .chart-room-icon {
    -unity-background-image-tint-color: var(--room-combat);
}

.tile-combat > .room-wall {
    -unity-background-image-tint-color: var(--room-combat);
}

.tile-elite,
.room-elite {
    border-color: var(--room-elite);
}

.tile-elite .tile-room-icon,
.room-elite .chart-room-icon {
    -unity-background-image-tint-color: var(--room-elite);
}

.tile-elite > .room-wall {
    -unity-background-image-tint-color: var(--room-elite);
}

.tile-investigation,
.room-investigation {
    border-color: var(--room-investigation);
}

.tile-investigation .tile-room-icon,
.room-investigation .chart-room-icon {
    -unity-background-image-tint-color: var(--room-investigation);
}

.tile-investigation > .room-wall {
    -unity-background-image-tint-color: var(--room-investigation);
}

.tile-event,
.room-event {
    border-color: var(--room-event);
}

.tile-event .tile-room-icon,
.room-event .chart-room-icon {
    -unity-background-image-tint-color: var(--room-event);
}

.tile-event > .room-wall {
    -unity-background-image-tint-color: var(--room-event);
}

.tile-sanctuary,
.room-sanctuary {
    border-color: var(--room-sanctuary);
}

.tile-sanctuary .tile-room-icon,
.room-sanctuary .chart-room-icon {
    -unity-background-image-tint-color: var(--room-sanctuary);
}

.tile-sanctuary > .room-wall {
    -unity-background-image-tint-color: var(--room-sanctuary);
}

.tile-secret,
.room-secret {
    border-color: var(--room-secret);
}

.tile-secret .tile-room-icon,
.room-secret .chart-room-icon {
    -unity-background-image-tint-color: var(--room-secret);
}

.tile-secret > .room-wall {
    -unity-background-image-tint-color: var(--room-secret);
}

.tile-boss,
.room-boss {
    border-color: var(--room-boss);
}

.tile-boss .tile-room-icon,
.room-boss .chart-room-icon {
    -unity-background-image-tint-color: var(--room-boss);
}

.tile-boss > .room-wall {
    -unity-background-image-tint-color: var(--room-boss);
}

.view-title {
    color: var(--brass);
    -unity-font-definition: url("Art/Fonts/Cinzel-SemiBold SDF.asset");
    -unity-font-style: normal;
}

.view-text,
.map-hint,
.health-chip-text {
    color: var(--text);
}

.view-subtext,
.map-legend,
.clue-count,
.cellar-title {
    color: var(--text-secondary);
}

.map-legend {
    font-size: 13px;
}

.map-entrance {
    padding-left: 22px;
}

.map-entrance.is-start > .current-mark {
    display: flex;
}

.party-hero .statuses {
    display: none;
}

.party-hero {
    padding-bottom: 6px;
}

.party-scroll {
    width: 100%;
    flex-grow: 1;
}

.party-scroll-content {
    align-items: center;
    padding: 8px 0;
}

#party-view {
    padding: 12px;
}

#party-view .view-title {
    margin-bottom: 4px;
}

#party-view .view-text {
    margin-bottom: 8px;
}

#party-view .view-subtext {
    margin-bottom: 4px;
}

.door-tag.with-icon,
.tile-stairs.with-icon {
    padding-left: 24px;
}

.tile-stairs .label-icon {
    width: 12px;
    height: 12px;
}

.room:focus {
    border-color: var(--focus);
}

.owner-iron .party-portrait {
    background-color: var(--card-iron);
    border-bottom-color: var(--hero-iron);
}

.owner-thorn .party-portrait {
    background-color: var(--card-thorn);
    border-bottom-color: var(--hero-thorn);
}

.owner-ash .party-portrait {
    background-color: var(--card-ash);
    border-bottom-color: var(--hero-ash);
}

.owner-bone .party-portrait {
    background-color: var(--card-bone);
    border-bottom-color: var(--hero-bone);
}

.owner-steel .party-portrait {
    background-color: var(--card-steel);
    border-bottom-color: var(--hero-steel);
}

.owner-bronze .party-portrait {
    background-color: var(--card-bronze);
    border-bottom-color: var(--hero-bronze);
}

.owner-smoke .party-portrait {
    background-color: var(--card-smoke);
    border-bottom-color: var(--hero-smoke);
}

.owner-ember .party-portrait {
    background-color: var(--card-ember);
    border-bottom-color: var(--hero-ember);
}

.owner-ink .party-portrait {
    background-color: var(--card-ink);
    border-bottom-color: var(--hero-ink);
}

.owner-rose .party-portrait {
    background-color: var(--card-rose);
    border-bottom-color: var(--hero-rose);
}

.owner-verdigris .party-portrait {
    background-color: var(--card-verdigris);
    border-bottom-color: var(--hero-verdigris);
}

.owner-tallow .party-portrait {
    background-color: var(--card-tallow);
    border-bottom-color: var(--hero-tallow);
}

/* Review fixes: reserve each top-bar item's width before distributing party space.
   Wrap the bar if its logical width is too narrow for three complete names. */
.top-bar {
    padding-left: 16px;
    padding-right: 16px;
    flex-wrap: wrap;
    height: auto;
    min-height: 48px;
}
.top-bar .place,
.top-bar .round {
    flex-shrink: 0;
    margin-right: 16px;
}
.party-health {
    min-width: 600px;
    flex-basis: auto;
    flex-shrink: 0;
}
.health-chip {
    flex-shrink: 0;
    margin-right: 12px;
}
.health-chip .swatch {
    flex-shrink: 0;
}
.health-chip-text {
    flex-shrink: 0;
    white-space: nowrap;
}
.top-bar .deck-count.with-icon {
    width: 116px;
    min-width: 116px;
    flex-shrink: 0;
    padding-left: 26px;
    margin-right: 10px;
    white-space: nowrap;
    -unity-text-align: middle-left;
}
.top-bar .seed {
    width: 126px;
    flex-shrink: 0;
    white-space: nowrap;
}
.top-bar .journal-button.with-icon {
    width: 150px;
    flex-shrink: 0;
    padding-left: 28px;
    margin-left: 10px;
    white-space: nowrap;
}
.door-tag.with-icon,
.tile-stairs.with-icon {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 2px;
    white-space: nowrap;
}
.door-tag.with-icon > .label-icon,
.tile-stairs.with-icon > .label-icon {
    position: relative;
    left: auto;
    top: auto;
    translate: 0 0;
    width: 12px;
    height: 12px;
    margin-right: 3px;
}
.tag-caption {
    margin: 0;
    padding: 0;
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
}
.tile-stairs.with-icon {
    min-height: 18px;
}
