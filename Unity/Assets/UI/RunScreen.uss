/* Run screens: party, map, reward, Sanctuary, Investigation, the secret room, unwritten rooms, the journal and the
   run's end. Card and panel styles come from
   CombatScreen.uss. */

.view {
    flex-grow: 1;
}

.centred {
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.view-title {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(201, 162, 74);
    margin-bottom: 12px;
}

.view-text {
    width: 760px;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 18px;
    margin-bottom: 24px;
}

.big-button {
    width: 240px;
    height: 48px;
    font-size: 18px;
    margin-top: 16px;
}

/* top bar */

.party-health {
    flex-direction: row;
    flex-grow: 1;
}

.health-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 18px;
}

.health-chip .swatch {
    flex-grow: 0;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 6px;
}

.health-chip-text {
    font-size: 14px;
}

.deck-count {
    margin-right: 24px;
    font-size: 14px;
}

/* party */

.party-heroes {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 1140px;
}

/* Six to choose from, in two rows of three. */
.party-hero {
    width: 340px;
    margin: 6px 12px;
    opacity: 0.6;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.party-hero:hover {
    opacity: 0.85;
}

.party-hero.is-chosen {
    opacity: 1;
    border-color: rgb(201, 162, 74);
}

.party-hero-cards {
    font-size: 12px;
    white-space: normal;
    color: rgb(190, 180, 165);
    margin-top: 6px;
}

/* map */

.map-view {
    flex-direction: row;
}

/* The map takes whatever width the side panel leaves; MapView spreads the rooms over its measured size. */
.map {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 24px 0 24px 20px;
}

.map-lines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.room {
    position: absolute;
    width: 128px;
    height: 56px;
    margin: 0;
    padding: 0;
    border-width: 2px;
    border-radius: 8px;
    border-color: rgb(58, 46, 60);
    background-color: rgb(34, 28, 36);
    color: rgb(150, 140, 146);
    font-size: 16px;
    -unity-font-style: bold;
}

.room-combat { border-color: rgb(120, 60, 60); }
.room-elite { border-color: rgb(200, 70, 60); }
.room-investigation { border-color: rgb(90, 120, 170); }
.room-event { border-color: rgb(130, 110, 160); }
.room-sanctuary { border-color: rgb(110, 160, 100); }
.room-secret { border-color: rgb(90, 160, 170); }
.room-boss { border-color: rgb(201, 162, 74); width: 150px; height: 72px; font-size: 20px; }

.room.is-reachable {
    background-color: rgb(64, 52, 40);
    color: rgb(245, 236, 216);
    border-width: 3px;
}

.room.is-reachable:hover {
    scale: 1.08 1.08;
    background-color: rgb(84, 68, 48);
}

.room.is-visited {
    background-color: rgb(70, 56, 26);
    color: rgb(232, 212, 138);
}

.room.is-current {
    border-color: rgb(232, 212, 138);
}

.room.is-closed {
    opacity: 0.35;
}

.map-side {
    width: 340px;
    flex-shrink: 0;
    padding: 40px 24px;
}

.map-hint {
    white-space: normal;
    min-height: 80px;
    font-size: 16px;
}

.map-legend {
    white-space: normal;
    font-size: 13px;
    color: rgb(150, 140, 146);
}

/* rewards and Sanctuary */

.card-row {
    flex-direction: row;
    justify-content: center;
    height: 240px;
    align-items: flex-end;
}

.card-row .card:hover,
.deck-grid .card:hover {
    translate: 0 -10px;
    border-color: rgb(232, 212, 138);
}

.choice-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.choice-button.is-selected {
    border-color: rgb(201, 162, 74);
    border-width: 2px;
}

.choice-button {
    width: 360px;
    height: 64px;
    margin: 0 12px;
    font-size: 16px;
    white-space: normal;
}

.reflect-panel {
    align-items: center;
}

.deck-grid-scroll {
    width: 90%;
    height: 560px;
}

.deck-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.deck-grid .card {
    margin: 14px 6px 0 6px;
}

/* end */

.run-summary {
    font-size: 16px;
    color: rgb(190, 182, 172);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* clues */

.view-subtext {
    width: 760px;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 15px;
    color: rgb(190, 182, 172);
    margin-bottom: 16px;
}

.found-clue {
    width: 760px;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 17px;
    color: rgb(150, 190, 240);
    margin-bottom: 18px;
}

.clue-count {
    margin-top: 24px;
    font-size: 15px;
    color: rgb(150, 190, 240);
}

.journal-button {
    height: 30px;
    margin-left: 18px;
    font-size: 14px;
}

.journal-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 8, 12, 0.85);
}

.journal-page {
    width: 820px;
    max-height: 90%;
    padding: 28px 36px;
    align-items: center;
    border-width: 2px;
    border-radius: 8px;
    border-color: rgb(120, 100, 70);
    background-color: rgb(30, 25, 30);
}

.journal-scroll {
    width: 100%;
    flex-shrink: 1;
}

.journal-entry {
    margin-bottom: 14px;
    padding: 10px 14px;
    border-left-width: 3px;
    border-color: rgb(90, 120, 170);
}

.journal-entry.is-unknown {
    border-color: rgb(60, 54, 62);
}

.journal-entry-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(232, 212, 138);
}

.journal-entry.is-unknown .journal-entry-name {
    color: rgb(110, 100, 108);
}

.journal-entry-text {
    white-space: normal;
    font-size: 15px;
}

.searcher {
    width: 260px;
}

.searcher.is-unavailable {
    opacity: 0.45;
}
