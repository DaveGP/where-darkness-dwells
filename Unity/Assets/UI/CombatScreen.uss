/* Combat screen. Placeholder look until Milestone 6: flat panels in the keep's colours.
   Hero colours: Iron is amber, Thorn is green, Ash is violet (GAME_DESIGN.md). */

.screen {
    flex-grow: 1;
    background-color: rgb(16, 13, 18);
    color: rgb(222, 214, 200);
    font-size: 16px;
}

.hidden {
    display: none;
}

/* ---------- top bar ---------- */

.top-bar {
    flex-direction: row;
    align-items: center;
    height: 48px;
    padding: 0 20px;
    background-color: rgb(26, 21, 29);
    border-bottom-width: 1px;
    border-color: rgb(58, 46, 60);
}

.place {
    -unity-font-style: bold;
    color: rgb(201, 162, 74);
    margin-right: 24px;
}

.round {
    margin-right: 24px;
}

.prompt {
    flex-grow: 1;
    color: rgb(240, 232, 214);
    -unity-font-style: italic;
}

.seed {
    font-size: 12px;
    color: rgb(120, 110, 118);
}

/* ---------- battlefield ---------- */

.middle {
    flex-grow: 1;
    flex-direction: row;
}

.battlefield {
    flex-grow: 1;
    justify-content: space-around;
    padding: 16px;
}

.combatant-row {
    flex-direction: row;
    justify-content: center;
}

.combatant {
    width: 230px;
    margin: 0 12px;
    padding: 10px 12px;
    background-color: rgb(30, 25, 33);
    border-width: 2px;
    border-radius: 6px;
    border-color: rgb(58, 46, 60);
}

.combatant-accent {
    height: 4px;
    margin: -4px -6px 8px -6px;
    border-radius: 2px;
    background-color: rgb(90, 80, 90);
}

.combatant-name {
    font-size: 18px;
    -unity-font-style: bold;
}

.combatant-title {
    font-size: 13px;
    color: rgb(150, 140, 146);
    margin-bottom: 6px;
}

.combatant-state {
    margin-top: 6px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(201, 162, 74);
}

.combatant.is-active {
    border-color: rgb(201, 162, 74);
    background-color: rgb(40, 33, 30);
}

.combatant.is-down {
    opacity: 0.4;
}

.combatant.is-down .combatant-state {
    color: rgb(190, 80, 80);
}

.combatant.is-targetable {
    border-color: rgb(232, 212, 138);
}

.combatant.is-targetable:hover {
    background-color: rgb(52, 44, 36);
    scale: 1.03 1.03;
}

.bar {
    height: 22px;
    margin: 4px 0;
    background-color: rgb(50, 22, 26);
    border-radius: 3px;
    overflow: hidden;
    justify-content: center;
}

.bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(150, 40, 48);
}

.bar-text {
    -unity-text-align: middle-center;
    font-size: 14px;
    -unity-font-style: bold;
}

.badges {
    flex-direction: row;
    flex-wrap: wrap;
}

.badge,
.status {
    font-size: 13px;
    padding: 2px 6px;
    margin: 3px 4px 0 0;
    border-radius: 3px;
    background-color: rgb(55, 50, 60);
}

.block-badge {
    background-color: rgb(55, 75, 100);
}

.guard-badge {
    background-color: rgb(110, 80, 40);
}

.statuses {
    flex-direction: row;
    flex-wrap: wrap;
    min-height: 22px;
}

.status-exposed {
    background-color: rgb(140, 70, 30);
}

.status-weak {
    background-color: rgb(70, 70, 110);
}

.status-bleed {
    background-color: rgb(120, 25, 35);
}

.status-hex {
    background-color: rgb(95, 50, 120);
}

.activate-button {
    margin: 8px 0 0 0;
    height: 30px;
}

/* enemies */

.enemy-row .combatant {
    background-color: rgb(34, 22, 26);
}

.intent {
    padding: 4px 6px;
    margin-bottom: 8px;
    border-radius: 3px;
    background-color: rgb(60, 28, 32);
}

.intent-text {
    -unity-font-style: bold;
    color: rgb(240, 200, 180);
}

.intent-target {
    font-size: 13px;
    color: rgb(200, 170, 160);
}

/* ---------- log ---------- */

.log-panel {
    width: 320px;
    padding: 12px;
    background-color: rgb(22, 18, 25);
    border-left-width: 1px;
    border-color: rgb(58, 46, 60);
}

.panel-heading {
    -unity-font-style: bold;
    color: rgb(201, 162, 74);
    margin-bottom: 6px;
}

.log {
    flex-grow: 1;
}

.log-line {
    font-size: 13px;
    white-space: normal;
    margin-bottom: 2px;
    color: rgb(190, 182, 172);
}

.log-round {
    margin-top: 8px;
    -unity-font-style: bold;
    color: rgb(201, 162, 74);
}

.log-end {
    -unity-font-style: bold;
    color: rgb(240, 232, 214);
}

/* ---------- hand and controls ---------- */

.bottom {
    flex-direction: row;
    height: 270px;
    padding: 8px 16px 16px 16px;
    background-color: rgb(22, 18, 25);
    border-top-width: 1px;
    border-color: rgb(58, 46, 60);
}

.hand-area {
    flex-grow: 1;
}

.hint {
    height: 24px;
    -unity-text-align: middle-center;
    color: rgb(200, 192, 180);
    white-space: normal;
}

.hint.is-error {
    color: rgb(235, 120, 110);
    -unity-font-style: bold;
}

.hand {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    flex-grow: 1;
}

.card {
    width: 150px;
    height: 210px;
    margin: 0 6px;
    padding: 0 10px 8px 10px;
    background-color: rgb(42, 36, 40);
    border-width: 2px;
    border-radius: 8px;
    border-color: rgb(80, 70, 76);
    transition-property: translate, scale, opacity;
    transition-duration: 0.12s;
}

.card:hover {
    translate: 0 -10px;
}

.card.is-unplayable {
    opacity: 0.45;
}

.card.is-unplayable:hover {
    translate: 0 0;
    opacity: 0.7;
}

.card.is-selected {
    translate: 0 -24px;
    border-color: rgb(232, 212, 138);
    background-color: rgb(58, 50, 44);
}

.card-owners {
    flex-direction: row;
    height: 8px;
    margin: 0 -10px 8px -10px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    overflow: hidden;
}

.swatch {
    flex-grow: 1;
}

.card-header {
    flex-direction: row;
    align-items: center;
}

.card-cost {
    width: 28px;
    height: 28px;
    margin-right: 6px;
    border-radius: 14px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    background-color: rgb(201, 162, 74);
    color: rgb(20, 16, 18);
}

.card-name {
    flex-shrink: 1;
    -unity-font-style: bold;
    white-space: normal;
}

.card-target {
    font-size: 12px;
    color: rgb(150, 140, 146);
    margin: 4px 0;
}

.card-text {
    flex-grow: 1;
    font-size: 14px;
    white-space: normal;
}

.card-owner-names {
    font-size: 12px;
    -unity-text-align: middle-center;
    color: rgb(150, 140, 146);
}

.controls {
    width: 190px;
    align-items: center;
    justify-content: center;
}

.resolve {
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(201, 162, 74);
}

.resolve-caption {
    margin-top: -6px;
    margin-bottom: 14px;
    color: rgb(150, 140, 146);
}

.end-button {
    width: 170px;
    height: 44px;
    font-size: 16px;
}

.piles {
    margin-top: 12px;
    font-size: 12px;
    color: rgb(150, 140, 146);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- previews and feedback (Milestone 2) ---------- */

.incoming-badge {
    background-color: rgb(110, 35, 40);
}

.incoming-badge.is-lethal {
    background-color: rgb(200, 50, 50);
    -unity-font-style: bold;
}

.intent-outcome {
    font-size: 13px;
    color: rgb(255, 170, 150);
    -unity-font-style: bold;
    white-space: normal;
}

.combatant.is-acting {
    border-color: rgb(220, 70, 60);
    scale: 1.05 1.05;
}

.card.is-highlighted {
    translate: 0 -12px;
    border-color: rgb(232, 212, 138);
}

.card.is-boosted {
    border-color: rgb(120, 200, 110);
}

.floaters {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.floater {
    position: absolute;
    width: 120px;
    -unity-text-align: middle-center;
    font-size: 24px;
    -unity-font-style: bold;
    transition-property: translate, opacity;
    transition-duration: 1.2s;
    transition-timing-function: ease-out;
}

.floater-gone {
    translate: 0 -48px;
    opacity: 0;
}

.floater-damage {
    color: rgb(255, 90, 80);
}

.floater-block {
    color: rgb(130, 180, 255);
}

.floater-status {
    color: rgb(240, 190, 90);
    font-size: 18px;
}

/* ---------- hero colours ---------- */

.owner-iron .combatant-accent,
.swatch.owner-iron {
    background-color: rgb(196, 138, 58);
}

.owner-thorn .combatant-accent,
.swatch.owner-thorn {
    background-color: rgb(96, 150, 72);
}

.owner-ash .combatant-accent,
.swatch.owner-ash {
    background-color: rgb(150, 112, 190);
}

.card.owner-iron {
    background-color: rgb(52, 40, 30);
}

.card.owner-thorn {
    background-color: rgb(32, 46, 32);
}

.card.owner-ash {
    background-color: rgb(42, 34, 52);
}

/* ---------- end of fight ---------- */

.end-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 6, 10, 0.8);
}

.end-box {
    width: 520px;
    padding: 28px;
    align-items: center;
    background-color: rgb(30, 25, 33);
    border-width: 2px;
    border-radius: 8px;
    border-color: rgb(201, 162, 74);
}

.end-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(201, 162, 74);
}

.end-text {
    margin: 12px 0 20px 0;
    white-space: normal;
    -unity-text-align: middle-center;
}

.again-button {
    width: 180px;
    height: 44px;
    font-size: 16px;
}
