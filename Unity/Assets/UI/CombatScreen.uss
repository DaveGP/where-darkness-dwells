.log .unity-scroller .unity-base-slider__tracker {
    background-image: url("Art/Controls/scroll-track.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 3;
    -unity-slice-top: 6;
    -unity-slice-right: 3;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 1px;
}

.log .unity-scroller .unity-base-slider__dragger {
    background-image: url("Art/Controls/scroll-thumb.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 3;
    -unity-slice-top: 8;
    -unity-slice-right: 3;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}

.log .unity-scroller .unity-base-slider__tracker {
    width: 10px;
    background-color: var(--recess);
}

.log .unity-scroller .unity-base-slider__dragger {
    min-height: 28px;
    background-color: var(--edge);
}

.log .unity-scroller .unity-base-slider__dragger:hover {
    background-color: var(--brass);
}

.log .unity-scroller .unity-base-slider__dragger:active {
    background-color: var(--focus);
}

.log .unity-scroller:focus {
    border-width: 2px;
    border-color: var(--focus);
}

