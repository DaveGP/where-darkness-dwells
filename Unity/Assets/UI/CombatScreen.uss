.intent-target > .owner-medal {
    position: absolute;
    left: 0;
    top: 0;
    width: 20px;
    height: 20px;
}

.intent-target.with-owner-mark {
    padding-left: 24px;
    min-height: 20px;
}

.health-chip .owner-medal {
    background-color: var(--panel);
}

.card.is-unplayable.is-discounted .card-cost {
    background-color: var(--benefit);
    color: var(--ink);
}

.unity-disabled {
    opacity: 1;
}

.card-cost {
    -unity-background-image-tint-color: var(--paper);
}

.card.is-discounted .card-cost,
.card.is-unplayable.is-discounted .card-cost {
    -unity-background-image-tint-color: var(--benefit);
}

.block-badge .ui-icon {
    -unity-background-image-tint-color: var(--hero-steel);
}

.guard-badge .ui-icon {
    -unity-background-image-tint-color: var(--brass);
}

.incoming-badge .ui-icon {
    display: none;
}

.incoming-badge.is-lethal .ui-icon {
    display: flex;
    -unity-background-image-tint-color: var(--danger);
}

.status-exposed .ui-icon,
.status-bleed .ui-icon {
    -unity-background-image-tint-color: var(--danger);
}

.status-weak .ui-icon,
.status-hex .ui-icon {
    -unity-background-image-tint-color: var(--hero-ash);
}

.status-riposte .ui-icon {
    -unity-background-image-tint-color: var(--hero-steel);
}

.status-fury .ui-icon {
    -unity-background-image-tint-color: var(--brass);
}

.card .owner-medal .hero-mark {
    width: 16px;
    height: 16px;
}

.card-cost {
    border-radius: 15px;
}

/* Review fixes: explicit text space for TextElements with decorative children.
   The icon's absolute box is independent of text measurement and never consumes it. */
.with-icon {
    padding-left: 26px;
    min-height: 22px;
}
.with-icon > .label-icon {
    left: 5px;
    top: 50%;
    translate: 0 -50%;
    width: 16px;
    height: 16px;
    background-color: rgba(0, 0, 0, 0);
}
.badge.with-icon,
.status.with-icon {
    padding: 3px 6px 3px 26px;
    min-width: 108px;
    white-space: nowrap;
}
.incoming-badge.with-icon {
    min-width: 112px;
    padding-left: 6px;
}
.incoming-badge.is-lethal.with-icon {
    min-width: 130px;
    padding-left: 26px;
}
.controls {
    width: 300px;
    min-width: 300px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}
.controls > * {
    flex-shrink: 0;
}
.controls .resolve {
    height: 54px;
    margin: 0;
    -unity-text-align: middle-center;
}
.controls .resolve-caption {
    width: 108px;
    height: 26px;
    margin: 0 0 6px 0;
    -unity-text-align: middle-left;
}
.controls .end-button {
    margin: 0;
}
.controls .discard-button.with-icon {
    width: 280px;
    height: 36px;
    margin: 6px 0 0 0;
    padding-left: 28px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.controls .piles.with-icon {
    width: 296px;
    height: 26px;
    margin: 6px 0 0 0;
    padding-left: 24px;
    padding-right: 0;
    font-size: 13px;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

/* Full sentences (guard source and lethal forecast) may wrap within the panel. */
.guard-badge.with-icon,
.incoming-badge.with-icon,
.incoming-badge.is-lethal.with-icon {
    width: 100%;
    min-width: 0;
    white-space: normal;
}
