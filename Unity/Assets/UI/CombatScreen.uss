/* The Siege Ledger. Exact slices match SpriteImporter; default Unity font uses approved sizes. */
@import url("SiegeLedger.uss");
.screen {
    flex-grow: 1;
}

.hidden {
    display: none;
}

.unity-button {
    border-width: 1px;
    border-radius: 0;
}

.top-bar {
    flex-direction: row;
    align-items: center;
    height: 48px;
    padding: 0 20px;
    border-bottom-width: 1px;
}

.place {
    -unity-font-style: bold;
    margin-right: 24px;
}

.round {
    margin-right: 24px;
}

.prompt {
    flex-grow: 1;
    -unity-font-style: italic;
}

.middle {
    flex-grow: 1;
    flex-direction: row;
}

.battlefield {
    flex-grow: 1;
    justify-content: space-around;
    padding: 16px;
}

.combatant-row {
    flex-direction: row;
    justify-content: center;
}

.combatant {
    width: 230px;
    margin: 0 12px;
    border-width: 2px;
    border-radius: 0;
}

.combatant-accent {
    height: 4px;
    margin: -4px -6px 8px -6px;
    border-radius: 0;
    background-color: var(--edge-quiet);
}

.combatant-title {
    font-size: 13px;
    margin-bottom: 6px;
}

.combatant-state {
    margin-top: 6px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.bar {
    height: 22px;
    margin: 4px 0;
    border-radius: 0;
    overflow: hidden;
    justify-content: center;
}

.bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.bar-text {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.badges {
    flex-direction: row;
    flex-wrap: wrap;
}

.badge,
.status {
    margin: 3px 4px 0 0;
    border-radius: 0;
}

.statuses {
    flex-direction: row;
    flex-wrap: wrap;
    min-height: 22px;
}

.activate-button {
    margin: 8px 0 0 0;
    height: 30px;
}

.intent {
    margin-bottom: 8px;
    border-radius: 0;
}

.intent-text {
    -unity-font-style: bold;
}

.log-panel {
    width: 320px;
    padding: 12px;
    border-left-width: 1px;
    border-color: var(--card-rose);
}

.panel-heading {
    margin-bottom: 6px;
}

.log {
    flex-grow: 1;
}

.log-line {
    white-space: normal;
    margin-bottom: 2px;
}

.log-round {
    margin-top: 8px;
    -unity-font-style: bold;
}

.log-end {
    -unity-font-style: bold;
}

.bottom {
    flex-direction: row;
    height: 270px;
    padding: 8px 16px 16px 16px;
    border-top-width: 1px;
    border-color: var(--card-rose);
}

.hand-area {
    flex-grow: 1;
}

.hint {
    height: 24px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hint.is-error {
    -unity-font-style: bold;
}

.hand {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    flex-grow: 1;
}

.card {
    margin: 0 6px;
    border-width: 2px;
    border-radius: 0;
    transition-property: translate, scale, opacity;
    transition-duration: 0.12s;
}

.card:hover {
    translate: 0 -10px;
}

.card.is-selected {
    background-color: var(--selected);
}

.card-owners {
    flex-direction: row;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    overflow: hidden;
    flex-shrink: 0;
}

.swatch {
    flex-grow: 1;
}

.card-header {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
}

.card-cost {
    width: 30px;
    height: 30px;
    margin-right: 6px;
    border-color: var(--health);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.card-name {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    -unity-font-style: bold;
    white-space: normal;
}

.card-target {
    flex-shrink: 0;
}

.card-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.card-owner-names {
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.controls {
    width: 190px;
    align-items: center;
    justify-content: center;
}

.resolve {
    -unity-font-style: bold;
}

.resolve-caption {
    margin-top: -6px;
    margin-bottom: 14px;
}

.end-button {
    width: 170px;
    height: 44px;
    font-size: 16px;
}

.discard-button {
    width: 170px;
    height: 32px;
    margin-top: 8px;
    font-size: 13px;
    white-space: normal;
}

.discard-button.is-selected {
    border-color: var(--hero-tallow);
    background-color: var(--selected);
}

.piles {
    margin-top: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.incoming-badge.is-lethal {
    -unity-font-style: bold;
}

.intent.is-vague .intent-text {
    -unity-font-style: italic;
}

.cancel-intent {
    margin: 0 0 8px 0;
    height: 30px;
    font-size: 14px;
    -unity-font-style: bold;
    border-color: var(--brass);
    color: var(--hero-tallow);
}

.intent-outcome {
    -unity-font-style: bold;
}

.combatant.is-acting {
    border-color: var(--hero-bronze);
}

.floaters {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.floater {
    position: absolute;
    width: 120px;
    -unity-text-align: middle-center;
    font-size: 24px;
    -unity-font-style: bold;
    transition-property: translate, opacity;
    transition-duration: 1.2s;
    transition-timing-function: ease-out;
}

.floater-gone {
    translate: 0 -48px;
    opacity: 0;
}

.floater-status {
    font-size: 18px;
}

.card.is-discounted .card-cost {
    border-color: var(--selected);
}

.end-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.end-box {
    width: 520px;
    padding: 28px;
    align-items: center;
    border-width: 2px;
    border-radius: 0;
    border-color: var(--brass);
}

.end-title {
    -unity-font-style: bold;
}

.end-text {
    margin: 12px 0 20px 0;
    white-space: normal;
    -unity-text-align: middle-center;
}

.again-button {
    width: 180px;
    height: 44px;
    font-size: 16px;
}

.has-stage .battlefield {
    justify-content: space-between;
}

.has-stage .battlefield {
    padding: 0;
}

.has-stage .combatant-row {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.has-stage .combatant {
    width: 200px;
    margin: 0;
}

.screen {
    background-image: url("Art/Surfaces/slate-field.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 24;
    -unity-slice-top: 24;
    -unity-slice-right: 24;
    -unity-slice-bottom: 24;
    -unity-slice-scale: 1px;
}

.unity-button {
    background-image: url("Art/Controls/button.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 12;
    -unity-slice-scale: 1px;
}

.unity-button:hover {
    background-image: url("Art/Controls/button-hover.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 12;
    -unity-slice-scale: 1px;
}

.unity-button:active {
    background-image: url("Art/Controls/button-pressed.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 12;
    -unity-slice-scale: 1px;
}

.unity-button:disabled,
.searcher.is-unavailable,
.cancel-intent.is-unavailable {
    background-image: url("Art/Controls/button-disabled.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 12;
    -unity-slice-scale: 1px;
}

.combatant {
    background-image: url("Art/Frames/fighter.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 1px;
}

.intent {
    background-image: url("Art/Frames/intent.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 8;
    -unity-slice-top: 8;
    -unity-slice-right: 8;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}

.badge,
.status,
.floater {
    background-image: url("Art/Frames/badge.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 1px;
}

.bar {
    background-image: url("Art/Bars/health-track.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 5;
    -unity-slice-top: 4;
    -unity-slice-right: 5;
    -unity-slice-bottom: 4;
    -unity-slice-scale: 1px;
}

.bar-fill {
    background-image: url("Art/Bars/health-fill.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 2;
    -unity-slice-top: 2;
    -unity-slice-right: 2;
    -unity-slice-bottom: 2;
    -unity-slice-scale: 1px;
}

.card {
    background-image: url("Art/Cards/binding.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 1px;
}

.top-bar,
.bottom,
.log-panel {
    background-image: url("Art/Frames/strip.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 4;
    -unity-slice-top: 4;
    -unity-slice-right: 4;
    -unity-slice-bottom: 4;
    -unity-slice-scale: 1px;
}

.end-box {
    background-image: url("Art/Frames/folio.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 16;
    -unity-slice-top: 16;
    -unity-slice-right: 16;
    -unity-slice-bottom: 16;
    -unity-slice-scale: 1px;
}

.card-cost {
    background-image: url("Art/Cards/cost.png");
    -unity-background-scale-mode: scale-to-fit;
}

.screen,
.menus {
    color: var(--text);
    font-size: 16px;
}

.screen {
    background-color: var(--void);
}

.unity-button {
    padding-left: 12px;
    padding-right: 12px;
    color: var(--text);
    background-color: var(--raised);
    border-color: var(--edge);
    font-size: 16px;
    -unity-font-style: bold;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.unity-button:hover {
    background-color: var(--hover);
    border-color: var(--brass);
    color: var(--text);
}

.unity-button:active {
    background-color: var(--pressed);
    translate: 0 1px;
}

.unity-button.is-selected,
.unity-button.is-selected:hover {
    background-color: var(--selected);
    border-color: var(--focus);
    border-width: 2px;
}

.unity-button:focus {
    border-color: var(--focus);
    border-width: 2px;
}

.unity-button:disabled,
.searcher.is-unavailable,
.cancel-intent.is-unavailable {
    background-color: var(--disabled);
    color: var(--text-muted);
    border-color: var(--edge-quiet);
    opacity: 1;
    translate: 0 0;
}

.top-bar {
    background-color: var(--recess);
    border-color: var(--brass);
    flex-shrink: 0;
}

.place,
.panel-heading,
.combatant-state {
    color: var(--brass);
}

.round,
.prompt {
    color: var(--text);
}

.seed,
.piles {
    font-size: 13px;
    color: var(--text-muted);
}

.panel-heading,
.combatant-name {
    font-size: 20px;
    -unity-font-style: bold;
}

.combatant {
    padding: 12px;
    background-color: var(--panel);
    border-color: var(--edge-quiet);
}

.enemy-row .combatant {
    background-color: var(--recess);
}

.combatant-title,
.intent-target {
    color: var(--text-secondary);
}

.combatant.is-active {
    background-color: var(--panel);
    border-color: var(--brass);
}

.combatant.is-down {
    opacity: 1;
}

.combatant.is-down .hero-mark {
    opacity: 0.45;
}

.combatant.is-down .combatant-state {
    color: var(--danger);
}

.combatant.is-targetable {
    border-color: var(--focus);
}

.combatant.is-targetable:hover {
    scale: 1 1;
    background-color: var(--hover);
}

.combatant.is-acting {
    scale: 1 1;
    border-left-color: var(--danger);
    border-left-width: 4px;
}

.bar {
    background-color: var(--health-track);
    border-width: 1px;
    border-color: var(--edge);
}

.bar-fill {
    background-color: var(--health);
}

.bar-text {
    color: var(--text);
    font-size: 14px;
}

.badge,
.status {
    min-height: 24px;
    padding: 2px 6px;
    font-size: 14px;
    background-color: var(--badge-surface);
    color: var(--text);
    flex-shrink: 0;
}

.block-badge,
.guard-badge,
.status-exposed,
.status-weak,
.status-bleed,
.status-hex {
    background-color: var(--badge-surface);
}

.incoming-badge,
.incoming-badge.is-lethal {
    background-color: var(--warning-surface);
}

.incoming-badge.is-lethal {
    border-color: var(--danger);
    border-width: 1px;
}

.intent {
    padding: 6px;
    background-color: var(--warning-surface);
}

.intent-text {
    font-size: 16px;
    color: var(--text);
    white-space: normal;
}

.intent-target,
.intent-outcome {
    font-size: 14px;
    white-space: normal;
}

.intent-outcome {
    color: var(--danger);
}

.intent.is-vague .intent-text,
.intent.is-cancelled .intent-text {
    color: var(--text-secondary);
}

.intent.is-cancelled {
    background-color: var(--recess);
}

.log-panel,
.bottom {
    background-color: var(--recess);
}

.log-line {
    font-size: 14px;
    color: var(--text-secondary);
}

.log-round {
    color: var(--brass);
}

.log-end {
    color: var(--text);
}

.hint {
    color: var(--text-secondary);
}

.hint.is-error {
    color: var(--danger);
}

.card {
    width: 150px;
    height: 210px;
    padding: 0 8px 4px 8px;
    background-color: var(--panel);
    border-color: var(--edge);
    overflow: visible;
    flex-shrink: 0;
}

.card-owners {
    height: 8px;
    margin: 0 -8px 4px -8px;
}

.card-owners .swatch {
    flex-basis: 0;
    flex-grow: 1;
    opacity: 1;
}

.card.is-dual .card-owners .swatch {
    border-right-width: 2px;
    border-right-color: var(--void);
}

.card-header {
    max-height: 40px;
    min-height: 34px;
}

.card-name {
    font-size: 15px;
    margin-top: 0;
}

.card-target {
    font-size: 13px;
    min-height: 17px;
    margin: 2px 0;
    color: var(--text-secondary);
}

.card-text {
    font-size: 14px;
    min-height: 80px;
    overflow: visible;
    color: var(--text);
}

.card-owner-names {
    font-size: 13px;
    color: var(--text-secondary);
    white-space: normal;
    margin: 0;
}

.card-cost {
    font-size: 20px;
    border-width: 0;
    background-color: var(--paper);
    color: var(--ink);
    flex-shrink: 0;
}

.card.is-dual {
    background-color: var(--panel);
}

.card:hover {
    border-color: var(--brass);
}

.card.is-unplayable {
    background-color: var(--recess);
    border-color: var(--edge-quiet);
}

.card.is-unplayable .card-name,
.card.is-unplayable .card-text {
    color: var(--text-muted);
}

.card.is-unplayable .card-owners {
    opacity: 1;
}

.card.is-unplayable .card-cost {
    background-color: var(--paper);
    color: var(--ink);
}

.card.is-discounted .card-cost {
    background-color: var(--benefit);
    color: var(--ink);
}

.card.is-highlighted {
    translate: 0 -12px;
    border-color: var(--focus);
}

.card.is-selected,
.card.is-selected:hover {
    translate: 0 -24px;
    border-color: var(--focus);
}

.card.is-unplayable:hover,
.card.is-unplayable.is-highlighted {
    translate: 0 0;
}

.card.is-unplayable.is-selected,
.card.is-unplayable.is-selected:hover {
    translate: 0 -24px;
    border-color: var(--focus);
}

.resolve {
    font-size: 48px;
    color: var(--brass);
}

.resolve-caption {
    color: var(--text-secondary);
}

.floater {
    background-color: var(--recess);
}

.floater-damage {
    color: var(--danger);
}

.floater-block {
    color: var(--hero-steel);
}

.floater-heal {
    color: var(--benefit);
}

.floater-status {
    color: var(--brass);
}

.end-panel {
    background-color: var(--scrim);
}

.end-box {
    background-color: var(--panel);
}

.end-title {
    font-size: 40px;
    color: var(--brass);
}

.end-text {
    font-size: 18px;
}

.has-stage .screen {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.has-stage .combatant,
.has-stage .enemy-row .combatant {
    background-color: var(--panel);
}

.has-stage .log-panel {
    background-color: var(--recess);
}

.ui-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text);
}

.label-icon {
    position: absolute;
    left: 4px;
    top: 3px;
    width: 16px;
    height: 16px;
}

.with-icon {
    padding-left: 26px;
}

.hero-mark {
    -unity-background-scale-mode: scale-to-fit;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
}

.owner-marks {
    height: 20px;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
}

.owner-medal {
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
}

.card .owner-medal {
    width: 20px;
    height: 20px;
}

.fighter-heading {
    flex-direction: row;
    align-items: center;
}

.fighter-heading .owner-medal {
    margin-right: 4px;
}

.card-state {
    position: absolute;
    width: 16px;
    height: 16px;
    display: none;
}

.boost-mark {
    right: -5px;
    top: 40px;
    -unity-background-image-tint-color: var(--benefit);
}

.discount-mark {
    left: -5px;
    top: 36px;
    -unity-background-image-tint-color: var(--benefit);
}

.lock-mark {
    right: -5px;
    bottom: 24px;
    -unity-background-image-tint-color: var(--text-muted);
}

.card.is-boosted .boost-mark,
.card.is-discounted .discount-mark,
.card.is-unplayable .lock-mark {
    display: flex;
}

.selection-frame,
.portrait-frame,
.room-wall {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.selection-frame {
    display: none;
}

.is-selected > .selection-frame,
.is-chosen > .selection-frame,
.is-targetable > .selection-frame,
.is-current > .selection-frame {
    display: flex;
}

.chosen-mark,
.current-mark,
.unexplored-mark {
    display: none;
    position: absolute;
    right: 4px;
    top: 4px;
}

.route-mark {
    display: none;
    position: absolute;
    right: 4px;
}

.is-chosen > .chosen-mark,
.is-current > .current-mark,
.is-visited > .route-mark,
.is-travelled > .route-mark,
.is-unexplored > .unexplored-mark {
    display: flex;
}

.current-mark {
    -unity-background-image-tint-color: var(--focus);
}

.route-mark {
    top: auto;
    bottom: 3px;
    width: 12px;
    height: 12px;
    -unity-background-image-tint-color: var(--brass);
}

.intent-icons {
    flex-direction: row;
}

.owner-medal {
    background-image: url("Art/Cards/owner-medal.png");
    -unity-background-scale-mode: scale-to-fit;
}

.selection-frame {
    background-image: url("Art/Frames/focus.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 8;
    -unity-slice-top: 8;
    -unity-slice-right: 8;
    -unity-slice-bottom: 8;
