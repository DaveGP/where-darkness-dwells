  id: bell_widow
  title: 'The Bell-founder''s Widow'
  scene: 'An old woman sits among the broken bells of the founder''s yard. Her husband silvered them for the siege. She will trade, she says. Everyone trades in the Keep.'
  choices:
  - label: 'Trade her something from the deck'
    result: 'She hands over a silvered clapper and takes what you give without looking at it.'
    requiresClue: {fileID: 0}
    hiddenByClue: {fileID: 11400000, guid: 7cc6a5fd9e6e4e8989a4e70a53ce4003, type: 2}
    outcomes:
    - kind: 8
      amount: 0
      id: ''
    - kind: 5
      amount: 0
      id: 'silvered_bells'
  - label: 'Take her veil'
    result: 'She lifts the black veil from her face and gives it to you. Her eyes are white.'
    requiresClue: {fileID: 0}
    hiddenByClue: {fileID: 0}
    outcomes:
    - kind: 6
      amount: 0
      id: 'widows_veil'
  - label: 'Leave her'
    result: 'She goes back to polishing a bell that will never ring.'
    requiresClue: {fileID: 0}
    hiddenByClue: {fileID: 0}
    outcomes: []
